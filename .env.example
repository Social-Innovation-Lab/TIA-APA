# ===========================================
# Tia Apa - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# OpenAI API Key (required for AI chat, voice, vision)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (optional - fallback for search)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# PostgreSQL Database URL (required for storing queries)
DATABASE_URL=postgresql://user:password@host:5432/database

# Google Flood Hub API Key (required for Bipod Barta flood warnings)
GOOGLE_FLOOD_HUB_API_KEY=your_google_flood_hub_api_key_here
